@page "/req-product-changes"
@using ERP.Warehouse.Models.Models.Product.ReqProductChanges
@using Microsoft.AspNetCore.Authorization
@inject ILogger<ReqProductChanges> _logger
@inject NavigationManager _navigationManager
@attribute [Authorize]
@using System.Net.Http.Json
@using WSIMS_ERP.Shared.Enums
@inject HttpClient httpClient

@if (_formType is EnumFormType.List or EnumFormType.Edit or EnumFormType.Create)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Style="font-weight: 600; color: #333; margin-bottom: 12px;">Requested Products Changes</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudTextField @bind-Value="_reqModel.ProductName" Label="Product Name" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" Clearable />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudTextField @bind-Value="_reqModel.ProductCode" Label="Product Code" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" Clearable />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudTextField @bind-Value="_reqModel.SupplierName" Label="Supplier Name" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" Clearable />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSelect @bind-Value="_reqModel.Status" Label="Status" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" Clearable>
                    @if (_lstStatus != null)
                    {
                        @foreach (var item in _lstStatus)
                        {
                            <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" Style="display: flex; align-items: flex-end; justify-content: flex-end; gap: 8px;">
                <MudButton ButtonType="MudBlazor.ButtonType.Button" Variant="MudBlazor.Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Close" OnClick="@Cancel">Cancel</MudButton>
                <MudButton ButtonType="MudBlazor.ButtonType.Button" Variant="MudBlazor.Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="@List">Search</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>


    <div style="width: 100%; overflow-x: auto;">
        <MudDataGrid @ref="_elementGrid"
                     T="ReqProductChangesModel"
                     Items="@_model"
                     Hover="@hover"
                     ReadOnly="@_readOnly"
                     Breakpoint="Breakpoint.None"
                     EditMode="MudBlazor.DataGridEditMode.Form"
                     StartedEditingItem="@Edit"
                     CanceledEditingItem="@Cancel"
                     CommittedItemChanges="@Save">

            <Columns>
                <TemplateColumn Title="No" Sortable="false" Filterable="false" HeaderStyle="width: 70px;" Style="width: 70px;">
                    <CellTemplate>
                        @(_model.ToList().IndexOf(context.Item) + 1)
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.ProductName" Title="Product Name" HeaderStyle="min-width: 180px;">
                    <EditTemplate>
                        <MudText Typo="Typo.h6" Style="padding: 16px 16px 0 16px; font-weight: bold;">
                            @_formType.ToString() Product Name
                        </MudText>
                        <MudTextField @bind-Value="_reqModel.ProductName"
                                      Label="Product Name"
                                      Margin="Margin.Dense"
                                      Style="width: 100%; min-width: 500px;"
                                      Variant="MudBlazor.Variant.Outlined"
                                      Required="true"
                                      RequiredError="Product Name is required!" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.ProductCode" Title="Product Code" HeaderStyle="min-width: 180px;">
                    <EditTemplate>
                        <MudTextField @bind-Value="_reqModel.ProductCode"
                                      Label="Product Code"
                                      Margin="Margin.Dense"
                                      Style="width: 100%; min-width: 500px;"
                                      Variant="MudBlazor.Variant.Outlined"
                                      Required="true"
                                      RequiredError="Product Code is required!" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.SupplierName" Title="Supplier Name" HeaderStyle="min-width: 180px;">
                    <EditTemplate>
                        <MudTextField @bind-Value="_reqModel.SupplierName"
                                      Label="Supplier Name"
                                      Margin="Margin.Dense"
                                      Style="width: 100%; min-width: 500px;"
                                      Variant="MudBlazor.Variant.Outlined"
                                      Required="true"
                                      RequiredError="Supplier Name is required!" />
                    </EditTemplate>
                </PropertyColumn>

                <TemplateColumn Title="Changes Type" HeaderStyle="min-width: 100px;">
                    <CellTemplate>
                        <MudText>@context.Item.ChangesType</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Status" HeaderStyle="min-width: 100px;">
                    <CellTemplate>
                        <MudText Class="@GetBadgeClass(context.Item.Status!)">@context.Item.Status</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.ImagePath" Title="ImagePath" HeaderStyle="min-width: 180px;" Hidden="true">
                    <EditTemplate>
                        <MudPaper Class="pa-4 mt-4">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #333; margin-bottom: 12px;">Product Image</MudText>
                            @if (!string.IsNullOrEmpty(_existingImagePath))
                            {
                                <div style="margin-bottom: 12px;">
                                    <img src="@GetImageUrl(_existingImagePath)" style="max-width: 200px; max-height: 200px; border: 1px solid #ddd; border-radius: 4px;" />
                                </div>
                            }
                            <div>
                                <InputFile OnChange="@OnImageUpload" accept="image/jpeg,image/png,image/gif" />
                            </div>
                            @if (_imagePreviewUrl is not null)
                            {
                                <div style="margin-top: 12px;">
                                    <img src="@_imagePreviewUrl" style="max-width: 200px; max-height: 200px; border: 1px solid #ddd; border-radius: 4px;" />
                                    <MudText Style="font-size: 12px; color: #888;">New image preview</MudText>
                                </div>
                            }
                        </MudPaper>
                    </EditTemplate>
                </PropertyColumn>

                <TemplateColumn Hidden="@_readOnly" Title="Actions" HeaderStyle="width: 140px; min-width: 140px;" Style="width: 140px; min-width: 140px; white-space: nowrap;">
                    <CellTemplate>
                        <div style="display: inline-block; white-space: nowrap;">
                            @{
                                var _isDisable = context.Item.Status != EnumRequestedStatus.Pending.ToString();
                                var _isDisableEdit = context.Item.ChangesType != EnumRequestedType.Update.ToString() ||
                                                     context.Item.Status != EnumRequestedStatus.Pending.ToString();
                            }
                            <MudFab Size="@Size.Small"
                                    Class="mr-2"
                                    StartIcon="@Icons.Material.Filled.Edit"
                                    Color="Color.Warning"
                                    OnClick="@context.Actions.StartEditingItemAsync"
                                    Disabled="_isDisableEdit" />

                            <MudFab Size="@Size.Small"
                                    Class="mr-2"
                                    StartIcon="@Icons.Material.Outlined.Delete"
                                    Color="Color.Error"
                                    OnClick="@(() => Delete(context.Item))"
                                    Disabled="_isDisable" />

                            <MudFab Size="@Size.Small"
                                    StartIcon="@Icons.Material.Outlined.Details"
                                    Color="Color.Primary"
                                    OnClick="@(() => Details(context.Item))" />
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ReqProductChangesModel" />

            </PagerContent>
        </MudDataGrid>
    </div>
}

@if (_formType is EnumFormType.Detail)
{
    <MudPaper Elevation="2" Class="pa-0 mt-4" Style="border-radius: 12px; overflow: hidden;">
        <div Style="background-color: #3f7375; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between;">
            <MudText Typo="Typo.h5" Style="color: #fff; font-weight: 600; margin: 0;">
                Requested Product Details
            </MudText>
            <MudFab Size="@Size.Small" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" Style="background-color: rgba(255,255,255,0.2); color: #fff;" OnClick="@(() => { _formType = EnumFormType.List; StateHasChanged(); })" />
        </div>
        <div Class="pa-6">
            <MudGrid>
                <MudItem xs="6">
                    <MudPaper Class="d-flex align-center justify-center mud-width-full pa-4" Elevation="0" Style="background-color: #e8e8e8; border-radius: 8px;">
                        <MudItem xs="12" sm="11">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #333; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #3f7375;">
                                Current Product Information
                            </MudText>
                            @foreach (var item in _details.OldInfo)
                            {
                                <ul class="list-unstyled mb-4">
                                    <li class="d-flex align-items-center mb-3">
                                        <MudText Typo="Typo.body2">
                                            <span Style="font-weight: 600; color: #555; min-width: 120px; display: inline-block;">@(item.Key) :</span>
                                            <span Style="color: #333;">@item.Value</span>
                                        </MudText>
                                    </li>
                                </ul>
                            }
                        </MudItem>
                    </MudPaper>
                </MudItem>

                <MudItem xs="6">
                    <MudPaper Class="d-flex align-center justify-center mud-width-full pa-4" Elevation="0" Style="background-color: #e8e8e8; border-radius: 8px;">
                        <MudItem xs="12" sm="11">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #333; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #3f7375;">
                                Changes Product Information
                            </MudText>
                            @foreach (var item in _details.ProductInfo)
                            {
                                <ul class="list-unstyled mb-4">
                                    <li class="d-flex align-items-center mb-3">
                                        <MudText Typo="Typo.body2">
                                            <span Style="font-weight: 600; color: #555; min-width: 120px; display: inline-block;">@(item.Key) :</span>
                                            <span Style="color: #333;">@item.Value</span>
                                        </MudText>
                                    </li>
                                </ul>
                            }
                            @if (!string.IsNullOrEmpty(_details.ItemImagePath))
                            {
                                <ul class="list-unstyled mb-4">
                                    <li class="d-flex align-items-center mb-3">
                                        <MudText Typo="Typo.body2">
                                            <span Style="font-weight: 600; color: #555; min-width: 120px; display: inline-block;">Image :</span>
                                            <img src="@GetImageUrl(_details.ItemImagePath)" style="max-width: 200px; max-height: 200px; border: 1px solid #ddd; border-radius: 4px;" />
                                        </MudText>
                                    </li>
                                </ul>
                            }
                        </MudItem>
                    </MudPaper>
                </MudItem>

                <MudItem xs="6">
                    <MudPaper Class="d-flex align-center justify-center mud-width-full pa-4" Elevation="0" Style="background-color: #e8e8e8; border-radius: 8px;">
                        <MudItem xs="12" sm="11">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #333; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #3f7375;">
                                Maker / Checker
                            </MudText>
                            @foreach (var item in _details.MakerChecker)
                            {
                                if (item.Key.Contains("Status"))
                                {
                                    <ul class="list-unstyled mb-4">
                                        <li class="d-flex align-items-center mb-3">
                                            <MudText Typo="Typo.body2">
                                                <span Style="font-weight: 600; color: #555; min-width: 150px; display: inline-block;">@(item.Key) :</span>
                                                <span class="@GetBadgeClass(item.Value)" Style="color: #333;">@item.Value</span>
                                            </MudText>
                                        </li>
                                    </ul>
                                }
                                else
                                {
                                    <ul class="list-unstyled mb-4">
                                        <li class="d-flex align-items-center mb-3">
                                            <MudText Typo="Typo.body2">
                                                <span Style="font-weight: 600; color: #555; min-width: 150px; display: inline-block;">@(item.Key) :</span>
                                                <span Style="color: #333;">@item.Value</span>
                                            </MudText>
                                        </li>
                                    </ul>
                                }
                            }
                        </MudItem>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </div>
    </MudPaper>
}