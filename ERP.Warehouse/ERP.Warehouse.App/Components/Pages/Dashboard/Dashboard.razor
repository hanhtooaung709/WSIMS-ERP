@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@inject ILogger<Dashboard> _logger
@attribute [Authorize]
@inject HttpClient httpClient

<MudGrid>

    <MudItem xs="12" md="6">

        <MudGrid Spacing="3">

            <MudItem xs="12" sm="6">
                <MudCard Elevation="25" Class="rounded-lg">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Products</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudAvatar Color="Color.Primary" Variant="MudBlazor.Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Medium" />
                            </MudAvatar>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.h4" Class="font-weight-bold">@_model.ProductCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-1">Registered Products</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudCard Elevation="25" Class="rounded-lg">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Packages</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudAvatar Color="Color.Info" Variant="MudBlazor.Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Medium" />
                            </MudAvatar>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.h4" Class="font-weight-bold">@_model.PackageCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-1">Available Packages</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudCard Elevation="25" Class="rounded-lg">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Stock Quantity</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudAvatar Color="Color.Success" Variant="MudBlazor.Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Medium" />
                            </MudAvatar>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.h4" Class="font-weight-bold">@_model.StockCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-1">Total Items in Stock</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudCard Elevation="25" Class="rounded-lg">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Stock Packages</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudAvatar Color="Color.Warning" Variant="MudBlazor.Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Medium" />
                            </MudAvatar>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.h4" Class="font-weight-bold">
                                @_model.PackageStockCount <span style="font-size: 1rem; color: gray;">/ @_model.PackageCount</span>
                            </MudText>

                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Color="Color.Warning">
                                @StockPackagePercentage.ToString("F1")%
                            </MudText>
                        </div>

                        <MudProgressLinear Color="Color.Warning" Value="@StockPackagePercentage" Class="my-2" Size="Size.Small" />

                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="mt-1">Available Stock Packages</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

        </MudGrid>

    </MudItem>

    <MudItem xs="6">
        <MudPaper Class="doc-section-component-container">
            <MudChart ChartType="ChartType.Bar"
                      ChartSeries="@_series"
                      AxisChartOptions="@_chartOptions"
                      @bind-SelectedIndex="_index"
                      XAxisLabels="@_productNames"
                      Width="100%"
                      Height="@($"{_height}px")" />
        </MudPaper>
    </MudItem>
</MudGrid>