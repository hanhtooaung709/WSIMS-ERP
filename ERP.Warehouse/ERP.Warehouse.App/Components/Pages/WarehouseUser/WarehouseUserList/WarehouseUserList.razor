@page "/warehouse-user-list"
@using ERP.Warehouse.Models.Models.WarehouseUserList
@using Microsoft.AspNetCore.Authorization
@inject ILogger<WarehouseUserList> _logger
@attribute [Authorize]
@using System.Net.Http.Json
@inject HttpClient httpClient

<MudDataGrid T="WarehouseUserModel"
             Items="@_model"
             Hover="@hover" ReadOnly="@_readOnly"
             EditMode="MudBlazor.DataGridEditMode.Form"
             StartedEditingItem="@Edit"
             CanceledEditingItem="@Cancel"
             CommittedItemChanges="@Save">

    <Columns>
        <TemplateColumn Title="No" Sortable="false" Filterable="false">
            <CellTemplate>
                @(_model.ToList().IndexOf(context.Item) + 1)
            </CellTemplate>
        </TemplateColumn>
        
        <PropertyColumn Property="x => x.FullName" Title="Name">
            <EditTemplate>
                <MudText Typo="Typo.h6" Style="padding: 16px 16px 0 16px; font-weight: bold;">
                    @_formType.ToString() Warehouse User
                </MudText>
                <MudTextField @bind-Value="_reqModel.FullName"
                              Label="Name"
                              Margin="Margin.Dense"
                              Style="width: 100%; min-width: 500px;"
                              Variant="MudBlazor.Variant.Outlined" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.StaffId" Title="StaffId">
            <EditTemplate>
                <MudTextField @bind-Value="_reqModel.StaffId"
                              Label="StaffId"
                              Margin="Margin.Dense"
                              Style="width: 100%; min-width: 500px;"
                              Variant="MudBlazor.Variant.Outlined"
                              Disabled="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.PhoneNo" Title="PhoneNo">
            <EditTemplate>
                <MudTextField @bind-Value="_reqModel.PhoneNo"
                              Label="Phone Number"
                              Margin="Margin.Dense"
                              Style="width: 100%; min-width: 500px;"
                              Variant="MudBlazor.Variant.Outlined" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Email" Title="Email">
            <EditTemplate>
                <MudTextField @bind-Value="_reqModel.Email"
                              Label="Email"
                              Margin="Margin.Dense"
                              InputType="InputType.Email"
                              Style="width: 100%; min-width: 500px;"
                              Variant="MudBlazor.Variant.Outlined" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.RoleName" Title="Role">
            <EditTemplate>
                <MudTextField @bind-Value="_reqModel.RoleName"
                              Label="Role"
                              Margin="Margin.Dense"
                              Style="width: 100%; min-width: 500px;"
                              Variant="MudBlazor.Variant.Outlined" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.BranchName" Title="BranchName">
            <EditTemplate>
                <MudTextField @bind-Value="_reqModel.BranchName"
                              Label="Branch"
                              Margin="Margin.Dense"
                              Style="width: 100%; min-width: 500px;"
                              Variant="MudBlazor.Variant.Outlined" />
            </EditTemplate>
        </PropertyColumn>

        <TemplateColumn Hidden="@_readOnly">
            <CellTemplate>
                <MudFab Size="@Size.Small"
                        StartIcon="@Icons.Material.Filled.Edit"
                        Color="Color.Warning"
                        OnClick="@context.Actions.StartEditingItemAsync" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>