@page "/warehouse-user-list"
@using ERP.Warehouse.Models.Models.WarehouseUserList
@using Microsoft.AspNetCore.Authorization
@inject ILogger<WarehouseUserList> _logger
@attribute [Authorize]
@using System.Net.Http.Json
@using WSIMS_ERP.Shared.Enums
@inject HttpClient httpClient

@if (_formType is EnumFormType.List or EnumFormType.Edit or EnumFormType.Create)
{
    <MudDataGrid @ref="_elementGrid"
                 T="WarehouseUserModel"
                 Items="@_model"
                 Hover="@hover" ReadOnly="@_readOnly"
                 EditMode="MudBlazor.DataGridEditMode.Form"
                 StartedEditingItem="@Edit"
                 CanceledEditingItem="@Cancel"
                 CommittedItemChanges="@Save">

        <ToolBarContent>
            <MudFab Size="@Size.Small"
                    Class="mr-3"
                    StartIcon="@Icons.Material.Outlined.Add"
                    Color="Color.Tertiary"
                    OnClick="@Create"/>
            <MudText Typo="Typo.h6">Add New</MudText>
        </ToolBarContent>

        <Columns>
            <TemplateColumn Title="No" Sortable="false" Filterable="false">
                <CellTemplate>
                    @(_model.ToList().IndexOf(context.Item) + 1)
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.FullName" Title="Name">
                <EditTemplate>
                    <MudText Typo="Typo.h6" Style="padding: 16px 16px 0 16px; font-weight: bold;">
                        @_formType.ToString() Warehouse User
                    </MudText>
                    <MudTextField @bind-Value="_reqModel.FullName"
                                  Label="Name"
                                  Margin="Margin.Dense"
                                  Style="width: 100%; min-width: 500px;"
                                  Variant="MudBlazor.Variant.Outlined" />
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.StaffId" Title="StaffId">
                <EditTemplate>
                    <MudTextField @bind-Value="_reqModel.StaffId"
                                  Label="StaffId"
                                  Margin="Margin.Dense"
                                  Style="width: 100%; min-width: 500px;"
                                  Variant="MudBlazor.Variant.Outlined"
                                  Disabled="@(_formType == EnumFormType.Edit)" />
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.PhoneNo" Title="PhoneNo">
                <EditTemplate>
                    <MudTextField @bind-Value="_reqModel.PhoneNo"
                                  Label="Phone Number"
                                  Margin="Margin.Dense"
                                  Style="width: 100%; min-width: 500px;"
                                  Variant="MudBlazor.Variant.Outlined" />
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Email" Title="Email">
                <EditTemplate>
                    <MudTextField @bind-Value="_reqModel.Email"
                                  Label="Email"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Email"
                                  Style="width: 100%; min-width: 500px;"
                                  Variant="MudBlazor.Variant.Outlined" />
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.RoleCode" Title="Role">
                <EditTemplate>
                    <MudTextField @bind-Value="_reqModel.RoleCode"
                                  Label="Role"
                                  Margin="Margin.Dense"
                                  Style="width: 100%; min-width: 500px;"
                                  Variant="MudBlazor.Variant.Outlined" />
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.BranchCode" Title="Branch">
                <EditTemplate>
                    <MudTextField @bind-Value="_reqModel.BranchCode"
                                  Label="Branch"
                                  Margin="Margin.Dense"
                                  Style="width: 100%; min-width: 500px;"
                                  Variant="MudBlazor.Variant.Outlined" />
                </EditTemplate>
            </PropertyColumn>

            <TemplateColumn Hidden="@_readOnly" CellClass="d-flex justify-between">
                <CellTemplate>
                    <MudFab Size="@Size.Small"
                            Class="mr-3"
                            StartIcon="@Icons.Material.Filled.Edit"
                            Color="Color.Warning"
                            OnClick="@context.Actions.StartEditingItemAsync" />

                    <MudFab Size="@Size.Small"
                            Class="mr-3"
                            StartIcon="@Icons.Material.Outlined.Delete"
                            Color="Color.Error"
                            OnClick="@(() => Delete(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="WarehouseUserModel" />
        </PagerContent>
    </MudDataGrid>
}