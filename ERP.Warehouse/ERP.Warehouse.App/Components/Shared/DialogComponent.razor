@using ERP.Warehouse.Models
@using WSIMS_ERP.Shared

<MudDialog Style="width: 350px;">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-3 mb-n1" />
            @Title
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@Message</MudText>
        @if (lstDynamicReport != null && lstDynamicReport.Count > 0)
        {
            foreach (var item in lstDynamicReport)
            {
                <MudTextField Value="@(item.Value.IsNullOrEmpty() ? "-" : item.Value)" Label="@item.Key" ReadOnly="true" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" OnClick="Cancel">No</MudButton>
        <MudButton Color="Color.Success" OnClick="Submit">Yes</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public List<DynamicReportModel> lstDynamicReport { get; set; } = new List<DynamicReportModel>();

    void Submit() => MudDialog.Close(DialogResult.Ok(true));
    void Cancel() => MudDialog.Cancel();

    private MudBlazor.DialogOptions dialogOptions = new()
        {
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraSmall,
            BackdropClick = false
        };

}