<MudPaper Width="280px" Elevation="0" Class="py-3">
    <MudNavMenu Color="Color.Success" Bordered="true" Rounded="true" Class="pa-2" Margin="Margin.Normal">

        <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>

        <MudNavGroup Title="Product" Icon="@Icons.Material.Filled.ShoppingBag">
            <MudNavLink Href="product-list" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ListAlt">Product List</MudNavLink>
            <MudNavLink Href="req-product" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AddShoppingCart">Requested Product</MudNavLink>
            <MudNavLink Href="req-product-changes" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ProductionQuantityLimits">Requested Product Changes</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Approve Product" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
            <MudNavLink Href="approve-req-product" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LibraryAddCheck">Approve Requested Product</MudNavLink>
            <MudNavLink Href="approve-req-product-changes" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.FactCheck">Approve Requested Product Changes</MudNavLink>
        </MudNavGroup>

        <MudNavLink Href="box" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Inventory">Box</MudNavLink>

        <MudNavLink Href="currency" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Paid">Currency</MudNavLink>

        <MudNavGroup Title="Package" Icon="@Icons.Material.Filled.ViewInAr">
            <MudNavLink Href="package" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.FormatListBulleted">Package List</MudNavLink>
            <MudNavLink Href="req-package" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LibraryAddCheck">Requested Package</MudNavLink>
            <MudNavLink Href="req-package-change" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.EditNote">Requested Package Change</MudNavLink>
        </MudNavGroup>

        <MudNavLink Href="branch" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Storefront">Branch</MudNavLink>
    
        <MudNavGroup Title="Warehouse user" Icon="@Icons.Material.Filled.Group">
            <MudNavLink Href="/warehouse-user-list" Icon="@Icons.Material.Filled.List">Warehouse user list</MudNavLink>
            <MudNavLink Href="/req-warehouse-user" Icon="@Icons.Material.Filled.PersonAdd">Requested Warehouse user</MudNavLink>
            <MudNavLink Href="/req-warehouse-user-changes" Icon="@Icons.Material.Filled.ManageAccounts">Requested Warehouse user changes</MudNavLink>
        </MudNavGroup>

    </MudNavMenu>
</MudPaper>
